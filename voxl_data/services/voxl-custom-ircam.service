[Unit]
Description=IRCAM stereo driver (raw + H264 stream)
After=voxl-wait-for-fs.service
Requires=voxl-wait-for-fs.service

[Service]
User=root
Type=simple
ExecStartPre=/bin/sleep 10
ExecStart=/usr/local/bin/voxl-custom-ircam.sh
Restart=on-failure
RestartSec=3
StartLimitBurst=3
StartLimitInterval=30
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
